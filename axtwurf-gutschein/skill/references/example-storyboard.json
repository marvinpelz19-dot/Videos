{
  "meta": { "title": "Introducing Northwind 2.0", "fps": 30, "bpm": 126, "product": "Northwind", "source": "https://northwind.example" },
  "theme": { "accent": "#27aef5" },
  "brand": { "name": "Northwind", "mark": "assets/mark.png", "domain": "northwind.example" },
  "scenes": [
    { "type": "sentence", "id": "cold", "bg": "night", "beats": 4, "spinMark": 1.6,
      "steps": [ { "at": 0.15, "text": "@img:assets/mark-white.png 2.0", "size": 108, "enter": "fade" }, { "at": 0.85, "text": "@img:assets/mark-white.png Northwind 2.0", "size": 108 } ],
      "defaults": { "iconScale": 0.95 } },
    { "type": "sentence", "id": "intro", "beats": 3,
      "steps": [ { "at": 0, "text": "@mark Introducing Northwind 2.0", "size": 108, "weight": 600, "enter": "fade" } ] },
    { "type": "sentence", "id": "hero", "beats": 5,
      "steps": [ { "at": 0, "text": "Hand", "size": 470, "enter": "blur" }, { "at": 0.5, "text": "Hand", "size": 84 }, { "at": 0.85, "text": "Hand off the [busywork]", "size": 84 } ] },

    { "type": "slot", "id": "slot-engine", "beats": 3, "lead": "New", "words": ["Engine", "Workspace", "Automations", "Mobile", "Northwind"], "target": "Engine", "from": "Workspace" },
    { "type": "plate", "id": "codename", "beats": 4, "src": "assets/generated/plate-waterfall.jpg",
      "title": { "steps": [ { "at": 0.1, "text": "Crosswind", "size": 150, "enter": "blur" } ], "defaults": { "y": 470 } } },
    { "type": "sentence", "id": "less-waiting", "beats": 4, "steps": [ { "at": 0, "text": "Less waiting", "size": 100 } ] },
    { "type": "plate", "id": "benchmark", "beats": 8, "src": "assets/generated/plate-glacier.jpg",
      "cards": [ { "kind": "stat", "at": 0.3, "mark": true, "title": "Crosswind vs. v1", "label": "Median task time", "value": 38, "suffix": "% faster", "decimals": 0, "note": "Source: northwind.example/benchmarks",
        "bars": [ { "label": "v1", "value": 0.92, "display": "2m 41s" }, { "label": "Crosswind", "value": 0.57, "display": "1m 40s" } ] } ] },

    { "type": "slot", "id": "slot-workspace", "beats": 3, "lead": "New", "words": ["Engine", "Workspace", "Automations", "Mobile", "Northwind"], "target": "Workspace", "from": "Engine" },
    { "type": "dock", "id": "all-tools", "beats": 12,
      "caption": { "steps": [ { "at": 1.1, "text": "All" }, { "at": 1.35, "text": "All your" }, { "at": 1.6, "text": "All your tools," }, { "at": 1.85, "text": "All your tools, one workspace" } ] } },
    { "type": "feature", "id": "f-reports", "beats": 4, "icon": "file-chart-column", "label": "Write reports" },
    { "type": "ui", "id": "prompt", "beats": 14, "src": "assets/ui-home.png", "frame": "window", "radius": 18,
      "camera": [ { "at": 0, "zoom": 1 }, { "at": 1.0, "zoom": 1 }, { "at": 2.0, "zoom": 1.7, "focus": [0.5, 0.42] }, { "at": 5.4, "zoom": 1.7, "focus": [0.5, 0.42] }, { "at": 6.4, "zoom": 1.4, "focus": [0.5, 0.6] } ],
      "typing": [ { "at": 2.2, "rect": [0.28, 0.4, 0.44, 0.05], "text": "Turn last week's sales calls into a one-page report", "size": 22, "cps": 30 } ],
      "cursor": [ { "at": 1.2, "x": 0.7, "y": 0.7 }, { "at": 1.9, "x": 0.4, "y": 0.42, "click": true }, { "at": 5.0, "x": 0.71, "y": 0.42 }, { "at": 5.3, "x": 0.71, "y": 0.42, "click": true }, { "at": 6.0, "hide": true, "x": 0.72, "y": 0.5 } ],
      "swap": [ { "at": 5.8, "src": "assets/ui-report.png" } ] },
    { "type": "sentence", "id": "edit", "beats": 4, "steps": [ { "at": 0, "text": "Change anything, in place", "enter": "type" } ], "cps": 20 },
    { "type": "montage", "id": "outputs", "beats": 8, "transition": "iris",
      "items": [ { "src": "assets/out-1.png", "beats": 2.5 }, { "src": "assets/out-2.png", "beats": 2.5, "origin": [0.7, 0.4] }, { "src": "assets/out-3.png", "beats": 3, "origin": [0.3, 0.6] } ] },

    { "type": "feature", "id": "f-auto", "beats": 4, "icon": "workflow", "label": "Automations" },
    { "type": "plate", "id": "triggers", "beats": 12, "src": "assets/generated/plate-salt-flat.jpg",
      "title": { "steps": [ { "at": 0, "text": "Runs" }, { "at": 0.22, "text": "Runs on" }, { "at": 0.44, "text": "Runs on your schedule" } ] },
      "cards": [ { "kind": "pairs", "at": 0.35, "every": 1.8, "items": [
        { "trigger": { "icon": "calendar-clock", "text": "Every Monday at 9:00." }, "action": { "mark": true, "text": "Send the weekly pipeline report." } },
        { "trigger": { "icon": "mail", "text": "When a customer email arrives." }, "action": { "mark": true, "text": "Draft a reply for review." } } ] } ] },
    { "type": "sentence", "id": "one-workspace", "beats": 6,
      "clouds": [ { "x": 960, "y": 560, "size": 760, "at": 0 } ],
      "steps": [ { "at": 0.1, "text": "One" }, { "at": 0.3, "text": "One | shared workspace" }, { "at": 0.9, "text": "Your whole team | One shared workspace" } ] },
    { "type": "sentence", "id": "night", "beats": 8, "bg": { "src": "assets/generated/clip-desk-night.mp4", "tint": "linear-gradient(90deg, rgba(0,0,0,0.5), rgba(0,0,0,0) 60%)" }, "tone": "dark", "drift": 0,
      "defaults": { "align": "left", "x": 150, "size": 100, "weight": 600 },
      "steps": [ { "at": 0.4, "text": "Done" }, { "at": 0.9, "text": "Done | [before you're back.]" } ] },

    { "type": "sentence", "id": "omt", "beats": 6,
      "steps": [ { "at": 0, "text": "One", "size": 440, "enter": "slide" }, { "at": 0.55, "text": "One", "size": 134 }, { "at": 0.8, "text": "One More Thing", "size": 134 } ] },
    { "type": "slot", "id": "slot-mobile", "beats": 3, "lead": "New", "words": ["Engine", "Workspace", "Automations", "Mobile", "Northwind"], "target": "Mobile", "from": "Automations" },
    { "type": "burst", "id": "meet", "beats": 8, "pillSteps": [ { "at": 0, "text": "Meet" }, { "at": 0.45, "text": "Meet Northwind Go!" } ], "burstAt": 1.55, "ball": true,
      "items": [ { "shape": "triangle", "color": "#27aef5", "eyes": true }, { "shape": "circle", "color": "#f25f5c", "eyes": true }, { "shape": "star", "color": "#f5c518", "eyes": true }, { "shape": "square", "color": "#8e8e93", "eyes": true } ], "count": 16 },
    { "type": "phone", "id": "phone", "beats": 9, "src": "assets/mobile-home.png", "bg": { "plate": "assets/generated/plate-dunes.jpg" }, "tone": "light",
      "headline": { "steps": [ { "at": 0.5, "text": "In your" }, { "at": 0.85, "text": "In your | [pocket.]" } ] } },
    { "type": "chat", "id": "thread", "beats": 10,
      "bubbles": [ { "at": 0.3, "who": "Research", "text": "Pulled the last four quarters and flagged two outliers." }, { "at": 1.9, "who": "Writer", "text": "Drafted the summary. Ready for your review." } ] },
    { "type": "pins", "id": "everywhere", "beats": 9, "src": "assets/generated/photo-street.jpg",
      "headline": { "steps": [ { "at": 0, "text": "Main Street," }, { "at": 0.35, "text": "Main Street, [covered.]" } ] },
      "pins": [ { "at": 0.8, "x": 0.2, "y": 0.6, "shape": "circle", "color": "#27aef5", "eyes": true, "label": "Florist" }, { "at": 1.1, "x": 0.5, "y": 0.45, "shape": "star", "color": "#f5c518", "eyes": true, "label": "Bakery" } ] },

    { "type": "sentence", "id": "hours", "beats": 8,
      "steps": [ { "at": 0, "text": "Northwind gives you" }, { "at": 0.35, "text": "Northwind gives you your hours back" } ],
      "deco": [ { "at": 1.3, "kind": "insert", "word": "hours" } ],
      "peek": [ { "shape": "triangle", "color": "#27aef5", "eyes": true, "edge": "bottom", "pos": 0.55, "size": 520, "at": 0.25, "depth": 0.6 } ] },
    { "type": "sentence", "id": "choose", "beats": 8,
      "steps": [ { "at": 0, "text": "You choose" }, { "at": 0.6, "text": "You choose what ships" } ],
      "deco": [ { "at": 1.7, "kind": "circle", "word": "You" } ] },
    { "type": "endcard", "id": "end", "beats": 12,
      "peek": [ { "shape": "circle", "color": "#8e8e93", "eyes": true, "edge": "left", "pos": 0.5, "size": 640, "at": 0.3, "depth": 0.5 }, { "shape": "star", "color": "#f5c518", "eyes": true, "edge": "top", "pos": 0.36, "size": 640, "at": 0.4, "depth": 0.5, "rot": 180 } ] }
  ]
}
